services:
  unaiter:
    image: harianto/unaiter:latest
    container_name: unaiter
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - ./data/unaiter:/var/lib/unaiter
    env_file:
      - .env
    environment:
      - TZ=${TZ:-UTC}
      - NITRO_HOST=0.0.0.0
      - NITRO_PORT=3000
      # Bun.serve idleTimeout seconds (max 255). 0 disables — keeps slow AI/SSE streams alive through quiet gaps.
      - NITRO_BUN_IDLE_TIMEOUT=${NITRO_BUN_IDLE_TIMEOUT:-0}
      - NUXT_ADMINISTRATOR_USERNAME=${ADMINISTRATOR_USERNAME:-}
      - NUXT_ADMINISTRATOR_PASSWORD=${ADMINISTRATOR_PASSWORD:-}
      - NUXT_DATA_ROOT=/var/lib/unaiter
