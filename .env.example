# Optional. Defaults to admin
ADMINISTRATOR_USERNAME=
ADMINISTRATOR_PASSWORD=
# Optional server-only session seal secret (≥32 chars). If unset, generated into dataRoot/app.secret
NUXT_APP_SECRET=
# Optional. Upstream fetch deadline in ms. Default 0 = disabled (streaming-safe, like dns01-proxy).
UNAITER_UPSTREAM_TIMEOUT_MS=
# Bun.serve idleTimeout seconds (max 255). Default 0 disables idle cuts on quiet SSE gaps.
NITRO_BUN_IDLE_TIMEOUT=0
